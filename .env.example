DATABASE_URL=postgresql://epoch:epoch-local-only@127.0.0.1:5432/epoch
# Optional: use private staged data instead of the committed deterministic demo.
EPOCH_DATA_ROOT=./tmp/satellite-data
SCHEDULER_POLL_MS=30000
# ETF holdings defaults to free local issuer CSV ingestion.
ETF_HOLDINGS_PROVIDER=local_csv
ETF_HOLDINGS_INPUT_DIR=./data/raw/etf-holdings
# Optional free fallback: ETF_HOLDINGS_PROVIDER=local_csv,sec_nport
# SEC requires an identifying application/contact User-Agent.
SEC_USER_AGENT=Epoch owner@example.com
# Optional paid provider: set ETF_HOLDINGS_PROVIDER=fmp and provide a key.
FMP_API_KEY=
ETF_HOLDINGS_MAX_AGE_DAYS=90
