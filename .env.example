DATABASE_URL=postgresql://epoch:epoch-local-only@127.0.0.1:5432/epoch
# Optional: use private staged data instead of the committed deterministic demo.
EPOCH_DATA_ROOT=./tmp/satellite-data
SCHEDULER_POLL_MS=30000
# One audited pipeline: IBKR -> .NDX -> held-symbol market data -> risk/quality.
EPOCH_DAILY_DATA_SYNC_ENABLED=true
EPOCH_DAILY_DATA_STARTUP_MAX_AGE_HOURS=20

# IBKR Flex Web Service: read-only, daily account statement synchronization.
# Create an Activity Flex Query with CSV output and include Trades,
# Cash Transactions, Net Asset Value, and Open Positions. Never commit the token.
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=
IBKR_FLEX_ACCOUNT_ID=ibkr_8602
IBKR_FLEX_USER_AGENT=Epoch owner@example.com
# Keep true unless this query intentionally imports ledger activity only.
IBKR_FLEX_REQUIRE_NAV=true
# Keep true so a successful refresh also guarantees current holdings.
IBKR_FLEX_REQUIRE_POSITIONS=true
# Deployment/startup reuses a successful sync within this window.
IBKR_FLEX_STARTUP_MAX_AGE_HOURS=20
# Generation is asynchronous; these defaults allow roughly 80 seconds.
IBKR_FLEX_POLL_INTERVAL_MS=10000
IBKR_FLEX_MAX_POLL_ATTEMPTS=8
# Public FRED NASDAQ100 daily-close synchronization; no API key is required.
NASDAQ100_SYNC_ENABLED=true
NASDAQ100_STARTUP_MAX_AGE_HOURS=20
FRED_TIMEOUT_MS=30000
# ETF holdings defaults to free local issuer CSV ingestion.
ETF_HOLDINGS_PROVIDER=local_csv
ETF_HOLDINGS_INPUT_DIR=./data/raw/etf-holdings
# Optional free fallback: ETF_HOLDINGS_PROVIDER=local_csv,sec_nport
# SEC requires an identifying application/contact User-Agent.
SEC_USER_AGENT=Epoch owner@example.com
# Optional paid provider: set ETF_HOLDINGS_PROVIDER=fmp and provide a key.
FMP_API_KEY=

# Phase 6 non-production Alpaca IEX minute-bar validation.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_INTRADAY_SYMBOLS=QQQ,SOXX
ALPACA_INTRADAY_START=
ALPACA_INTRADAY_END=
ETF_HOLDINGS_MAX_AGE_DAYS=90
