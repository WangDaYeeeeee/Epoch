    "market:fetch": "node --import tsx scripts/fetch-market-data.ts",
    "import:flex": "node --import tsx scripts/import-flex.ts",
    "scheduler": "node --import tsx scripts/scheduler.ts",
    "scheduler:once": "node --import tsx scripts/scheduler.ts --once"
  },
  "dependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "postgres": "^3.4.7",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
