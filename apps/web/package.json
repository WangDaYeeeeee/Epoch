{
  "name": "@epoch/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "NEXT_DIST_DIR=.next-build next build",
    "start": "NEXT_DIST_DIR=.next-build next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node --import tsx scripts/migrate.ts",
