{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epoch.local/contracts/analytics/v1/portfolio-risk-output.schema.json",
  "title": "Epoch portfolio risk output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "asOf",
    "baseCurrency",
    "estimator",
    "portfolio",
    "instruments",
    "correlation",
    "policyGate",
    "quality"
  ],
  "properties": {
    "schemaVersion": { "const": "portfolio-risk-output/1.0" },
    "asOf": { "type": "string", "format": "date-time" },
    "baseCurrency": { "const": "USD" },
    "estimator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "status", "volatilityMethod", "covarianceMethod", "windowTradingDays", "annualizationFactor"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "status": { "enum": ["full", "degraded"] },
        "volatilityMethod": { "enum": ["shar_iv_j", "garman_klass_60d", "close_to_close_60d"] },
        "covarianceMethod": { "enum": ["sample_250d", "shrinkage_250d"] },
        "windowTradingDays": { "type": "integer", "minimum": 2 },
        "annualizationFactor": { "const": 252 }
      }
    },
    "portfolio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["volatilityAnnualized", "stressVolatilityAnnualized", "historicalCvarLoss", "cvarConfidence", "units"],
      "properties": {
        "volatilityAnnualized": { "type": "number", "minimum": 0 },
        "stressVolatilityAnnualized": { "type": "number", "minimum": 0 },
        "historicalCvarLoss": { "type": ["number", "null"], "minimum": 0 },
        "cvarConfidence": { "const": 0.95 },
        "units": {
          "type": "object",
          "additionalProperties": false,
          "required": ["volatility", "cvar"],
          "properties": {
            "volatility": { "const": "annualized_decimal" },
            "cvar": { "const": "portfolio_value_decimal_loss" }
          }
        }
      }
    },
    "instruments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["instrumentId", "weight", "volatilityAnnualized", "riskContribution", "riskCapitalRatio"],
        "properties": {
          "instrumentId": { "type": "string", "pattern": "^[^:]+:.+$" },
          "weight": { "type": "number" },
          "volatilityAnnualized": { "type": "number", "minimum": 0 },
          "riskContribution": { "type": "number" },
          "riskCapitalRatio": { "type": ["number", "null"] }
        }
      }
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windowTradingDays", "instrumentOrder", "matrix"],
      "properties": {
        "windowTradingDays": { "const": 250 },
        "instrumentOrder": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[^:]+:.+$" }
        },
        "matrix": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "number", "minimum": -1, "maximum": 1 }
          }
        }
      }
    },
    "policyGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateId", "limitAnnualized", "observedAnnualized", "passed", "violations"],
      "properties": {
        "gateId": { "const": "portfolio_volatility_cap" },
        "limitAnnualized": { "const": 0.45 },
        "observedAnnualized": { "type": "number", "minimum": 0 },
        "passed": { "type": "boolean" },
        "violations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["PORTFOLIO_VOLATILITY_CAP_EXCEEDED"] }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "missingInstrumentIds", "warnings"],
      "properties": {
        "status": { "enum": ["complete", "degraded"] },
        "missingInstrumentIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[^:]+:.+$" }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
